# Copy to .env and fill in. .env is gitignored.
# docker compose up -d --build

PORT=8787
LIVE_DESK_LOOP=1

# Free alerts. Each person opens the bot and presses Start, then add their chat id.
# Comma-separate ids. A negative id is a group (everyone in the group sees it).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=123456789,987654321

# Paid. Leave blank unless you want texts or WhatsApp as well.
# SMS_TO=15551111111,15552222222
# TEXTBELT_KEY=
# WHATSAPP_TO=
# CALLMEBOT_APIKEY=
