# Copy to .env and fill in. .env is gitignored.
# docker compose up -d --build

PORT=8787
LIVE_DESK_LOOP=1

# Comma-separated mobiles. Each one receives the same stock text.
SMS_TO=15551111111,15552222222
TEXTBELT_KEY=

# Twilio SMS instead of TextBelt. Leave blank to skip.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+15551234567

# Optional WhatsApp. CallMeBot is often full; SMS above is enough.
# WHATSAPP_TO=
# CALLMEBOT_APIKEY=
